# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Postgres for the queue. Empty locally: uses PGlite in .data.
DATABASE_URL=

# Optional. Without them, replies, cards and alerts are simulated and only recorded.
# Bot token from @BotFather. The webhook secret is any long random string you choose.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Chat that receives urgent alerts. `npm run setup:telegram -- chats` lists yours.
TELEGRAM_OPS_CHAT_ID=

# https://trello.com/power-ups/admin → your Power-Up → API key, then generate a token.
# `npm run setup:trello -- lists` shows the list ids of your boards.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Optional limits, to protect the free model quota. Defaults: 60 messages and 40 model classifications per day.
DAILY_MESSAGE_LIMIT=
DAILY_MODEL_LIMIT=

# Optional. Turns on /api/classify for the n8n version of the workflow. Any long random string.
CLASSIFY_TOKEN=
